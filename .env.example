# Environment variables for local development.
# This file starts empty — later tickets add their own variables here as they
# introduce them (server settings, Firebase, WordPress, etc). Copy to .env
# and fill in values; .env is gitignored.

API_URL=http://localhost:8000
APP_ENV=local

# Public base URL of the client-facing web app, used to build review links
# (e.g. https://app.example.com -> https://app.example.com/review/<token>).
WEB_BASE_URL=http://localhost:3000

FIRESTORE_EMULATOR_HOST=firebase:8081
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_CLOUD_PROJECT=demo-content-importer

# Agency login (T-026). NEXT_PUBLIC_* vars reach the browser, so the API key
# and auth domain are not secrets here — the emulator doesn't validate them.
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-content-importer.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-content-importer
# Browser-side address of the Auth emulator (not the `web` container's).
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# The one agency account. `make agency-user` creates it in the Auth emulator;
# re-run it after `make firebase-reset`.
AGENCY_EMAIL=agency@example.test
AGENCY_PASSWORD=local-password

# WordPress (local Docker container — see docs/architecture.md "Local setup")
# MARIADB_* configure the mariadb container; WP_USERNAME/WP_APP_PASSWORD are
# populated by `make wp-setup` the first time you run it — leave them blank here.
MARIADB_ROOT_PASSWORD=local
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=local
WP_BASE_URL=http://localhost:8080
WP_USERNAME=
WP_APP_PASSWORD=

# Review link plaintext token (T-016): same trust tier as the WordPress
# credentials above, but not read from env here — the running app persists
# it to server/.secrets.local.json (gitignored) so it survives restarts.
# On GCP this moves to Secret Manager (see the deploy ticket, Phase 5).

# Symmetric key encrypting each client site's WordPress app password at rest
# (T-031). Generate one locally:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Shared by web and api. The web app sends it with the client's IP so the
# API can rate-limit review requests per client (an X-Forwarded-For from
# anyone else is ignored). Any random string locally; required on GCP.
INTERNAL_API_SECRET=local-internal-secret
