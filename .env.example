# Environment variables for local development.
# This file starts empty — later tickets add their own variables here as they
# introduce them (server settings, Firebase, WordPress, etc). Copy to .env
# and fill in values; .env is gitignored.

API_URL=http://localhost:8000
APP_ENV=local

FIRESTORE_EMULATOR_HOST=firebase:8081
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_CLOUD_PROJECT=demo-content-importer
