# Copy to ~/app/.env on the VPS, then chmod 600 .env.
WEB_BASE_URL=https://app.aiwitharifin.com
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it once sites exist: their saved passwords and review links stop decrypting.
CREDENTIAL_ENCRYPTION_KEY=
# openssl rand -base64 32
INTERNAL_API_SECRET=
# Comma-separated. Only these Firebase accounts can sign in.
AGENCY_EMAILS=
