    "/review-link/reset": {
      "post": {
        "operationId": "reset_review_link_route_review_link_reset_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewLinkOut"
                }
              }
            },
            "description": "Successful Response"
          }
