{
  "components": {
    "schemas": {
      "ArticleCard": {
        "properties": {
          "id": {
            "description": "Article id.",
            "title": "Id",
            "type": "string"
          },
          "publish_at_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scheduled publish time, UTC.",
            "title": "Publish At Utc"
          },
          "published_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Live URL, once published.",
            "title": "Published Url"
          },
          "slug": {
            "description": "URL slug.",
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "description": "Article title.",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "slug"
        ],
        "title": "ArticleCard",
        "type": "object"
      },
      "ArticleDetail": {
        "properties": {
          "approved_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Version the client approved, if any.",
            "title": "Approved Version"
          },
          "body_html": {
            "description": "Article body, as HTML.",
            "title": "Body Html",
            "type": "string"
          },
          "created_at": {
            "description": "Creation time, UTC.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "events": {
            "default": [],
            "description": "History log, oldest first.",
            "items": {
              "$ref": "#/components/schemas/EventOut"
            },
            "title": "Events",
            "type": "array"
          },
          "id": {
            "description": "Article id.",
            "title": "Id",
            "type": "string"
          },
          "last_checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last WordPress status check time.",
            "title": "Last Checked At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error from the last failed WordPress call.",
            "title": "Last Error"
          },
          "publish_at_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scheduled publish time, UTC.",
            "title": "Publish At Utc"
          },
          "published_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Live URL, once published.",
            "title": "Published Url"
          },
          "slug": {
            "description": "URL slug.",
            "title": "Slug",
            "type": "string"
          },
          "source": {
            "description": "How the article was imported: paste or docx.",
            "title": "Source",
            "type": "string"
          },
          "source_filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Original filename, if imported from a file.",
            "title": "Source Filename"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "description": "Current lifecycle status."
          },
          "sync_warning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncWarning"
              },
              {
                "type": "null"
              }
            ],
            "description": "Warning from the last WordPress status check, if any."
          },
          "title": {
            "description": "Article title.",
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "description": "Last update time, UTC.",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "description": "Increments on every body edit.",
            "title": "Version",
            "type": "integer"
          },
          "warnings": {
            "default": [],
            "description": "Warnings produced during import.",
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "wp_post_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "WordPress post id, once sent.",
            "title": "Wp Post Id"
          }
        },
        "required": [
          "id",
          "title",
          "slug",
          "body_html",
          "source",
          "status",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "ArticleDetail",
        "type": "object"
      },
      "ArticlePaste": {
        "properties": {
          "html": {
            "description": "Pasted article HTML, raw body capped at 2 MB.",
            "title": "Html",
            "type": "string"
          }
        },
        "required": [
          "html"
        ],
        "title": "ArticlePaste",
        "type": "object"
      },
      "ArticleSummary": {
        "properties": {
          "id": {
            "description": "Article id.",
            "title": "Id",
            "type": "string"
          },
          "publish_at_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scheduled publish time, UTC.",
            "title": "Publish At Utc"
          },
          "slug": {
            "description": "URL slug.",
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "description": "Current lifecycle status."
          },
          "sync_warning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncWarning"
              },
              {
                "type": "null"
              }
            ],
            "description": "Warning from the last WordPress status check, if any."
          },
          "title": {
            "description": "Article title.",
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "description": "Last update time, UTC.",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "slug",
          "status",
          "updated_at"
        ],
        "title": "ArticleSummary",
        "type": "object"
      },
      "ArticleUpdate": {
        "properties": {
          "body_html": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "New body HTML, cleaned like import, capped at 2 MB.",
            "title": "Body Html"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "New slug: lowercase letters, digits, hyphens.",
            "title": "Slug"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "New title.",
            "title": "Title"
          }
        },
        "title": "ArticleUpdate",
        "type": "object"
      },
      "Body_upload_articles_articles_upload_post": {
        "properties": {
          "files": {
            "default": [],
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "title": "Body_upload_articles_articles_upload_post",
        "type": "object"
      },
      "EventOut": {
        "properties": {
          "actor": {
            "description": "Who or what triggered the event.",
            "title": "Actor",
            "type": "string"
          },
          "at": {
            "description": "When the event happened, UTC.",
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The comment or error attached to this event.",
            "title": "Data"
          },
          "id": {
            "description": "Event id.",
            "title": "Id",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType",
            "description": "What happened."
          }
        },
        "required": [
          "id",
          "type",
          "actor",
          "at"
        ],
        "title": "EventOut",
        "type": "object"
      },
      "EventType": {
        "enum": [
          "imported",
          "edited",
          "sent_for_review",
          "pulled_back",
          "approved",
          "changes_requested",
          "scheduled",
          "date_changed",
          "published",
          "failed",
          "retried",
          "ai_draft_created",
          "ai_draft_accepted"
        ],
        "title": "EventType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReviewArticleOut": {
        "properties": {
          "body_html": {
            "description": "Article body, as HTML.",
            "title": "Body Html",
            "type": "string"
          },
          "id": {
            "description": "Article id.",
            "title": "Id",
            "type": "string"
          },
          "slug": {
            "description": "URL slug.",
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "description": "Current lifecycle status."
          },
          "title": {
            "description": "Article title.",
            "title": "Title",
            "type": "string"
          },
          "version": {
            "description": "Increments on every body edit.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "slug",
          "body_html",
          "version",
          "status"
        ],
        "title": "ReviewArticleOut",
        "type": "object"
      },
      "ReviewLinkOut": {
        "properties": {
          "created_at": {
            "description": "When this token was generated, UTC.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "url": {
            "description": "Full review link URL, built from the plaintext token.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "created_at"
        ],
        "title": "ReviewLinkOut",
        "type": "object"
      },
      "ReviewPageOut": {
        "properties": {
          "published": {
            "description": "Already live.",
            "items": {
              "$ref": "#/components/schemas/ArticleCard"
            },
            "title": "Published",
            "type": "array"
          },
          "site_name": {
            "description": "The site's name.",
            "title": "Site Name",
            "type": "string"
          },
          "upcoming": {
            "description": "Scheduled to publish.",
            "items": {
              "$ref": "#/components/schemas/ArticleCard"
            },
            "title": "Upcoming",
            "type": "array"
          },
          "waiting": {
            "description": "Awaiting the client's review.",
            "items": {
              "$ref": "#/components/schemas/ArticleCard"
            },
            "title": "Waiting",
            "type": "array"
          }
        },
        "required": [
          "site_name",
          "waiting",
          "upcoming",
          "published"
        ],
        "title": "ReviewPageOut",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "id_token": {
            "description": "Firebase ID token from the client-side sign-in.",
            "examples": [
              "eyJhbGciOiJSUzI1NiIsImtpZCI6..."
            ],
            "title": "Id Token",
            "type": "string"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "Status": {
        "enum": [
          "draft",
          "awaiting_approval",
          "changes_requested",
          "approved",
          "scheduled",
          "published",
          "failed"
        ],
        "title": "Status",
        "type": "string"
      },
      "SyncWarning": {
        "enum": [
          "late",
          "changed_in_wordpress",
          "missing_in_wordpress"
        ],
        "title": "SyncWarning",
        "type": "string"
      },
      "UploadFileResult": {
        "properties": {
          "article": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ArticleSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "The created article, if import succeeded."
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error code, if import failed.",
            "title": "Code"
          },
          "filename": {
            "description": "Name of the uploaded file.",
            "title": "Filename",
            "type": "string"
          },
          "ok": {
            "description": "Whether this file was imported successfully.",
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "filename",
          "ok"
        ],
        "title": "UploadFileResult",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "results": {
            "description": "One result per uploaded file, in request order.",
            "items": {
              "$ref": "#/components/schemas/UploadFileResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Content Importer API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/articles": {
      "get": {
        "operationId": "list_articles_articles_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Status"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "items": {
                      "$ref": "#/components/schemas/ArticleSummary"
                    },
                    "type": "array"
                  },
                  "title": "Response List Articles Articles Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Articles"
      }
    },
    "/articles/paste": {
      "post": {
        "operationId": "paste_article_articles_paste_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticlePaste"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Paste Article"
      }
    },
    "/articles/upload": {
      "post": {
        "operationId": "upload_articles_articles_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_articles_articles_upload_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Articles"
      }
    },
